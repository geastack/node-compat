{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-node",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["server.ts", "shared/**/*.ts", "generated/**/*.ts"]
}
