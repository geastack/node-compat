{
  "name": "@geastack/hono-mongodb-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/run-with-work-env.mjs npm run check:work",
    "check:work": "tsc --noEmit -p tsconfig.frontend.json && tsc --noEmit -p tsconfig.server.json",
    "check:fullstack": "node scripts/run-with-work-env.mjs node scripts/check-fullstack.mjs",
    "check:fullstack:browser": "node scripts/run-with-work-env.mjs node scripts/check-fullstack-browser.mjs",
    "build:frontend": "node scripts/run-with-work-env.mjs npm run build:frontend:work",
    "build:frontend:work": "vite build",
    "embed:frontend": "node scripts/run-with-work-env.mjs npm run embed:frontend:work",
    "embed:frontend:work": "node scripts/embed-frontend.mjs",
    "build:assets": "node scripts/run-with-work-env.mjs npm run build:assets:work",
    "build:assets:work": "npm run build:frontend:work && npm run embed:frontend:work",
    "build:node": "node scripts/run-with-work-env.mjs npm run build:node:work",
    "build:node:work": "tsc -p tsconfig.server.json",
    "build": "node scripts/run-with-work-env.mjs npm run build:work",
    "build:work": "npm run build:assets:work && npm run build:node:work",
    "node": "node scripts/run-with-work-env.mjs npm run node:work",
    "node:work": "npm run build:work && node dist-node/server.js",
    "build:native:hono": "node scripts/run-with-work-env.mjs npm run build:native:hono:work",
    "build:native:hono:work": "npm run build:assets:work && node ../../scripts/build.mjs server.ts --globals --out dist --exe dist/hono",
    "native:hono": "node scripts/run-with-work-env.mjs npm run native:hono:work",
    "native:hono:work": "npm run build:native:hono:work && ./dist/hono",
    "build:native:hono-mongodb": "node scripts/run-with-work-env.mjs npm run build:native:hono-mongodb:work",
    "build:native:hono-mongodb:work": "npm run build:assets:work && node ../../scripts/build.mjs server.ts --globals --out dist --exe dist/hono-mongodb",
    "native:hono-mongodb": "node scripts/run-with-work-env.mjs npm run native:hono-mongodb:work",
    "native:hono-mongodb:work": "npm run build:native:hono-mongodb:work && ./dist/hono-mongodb",
    "emit:native:mongodb-ping": "node scripts/run-with-work-env.mjs node scripts/native-mongodb-correctness.mjs ping --emit-only",
    "build:native:mongodb-ping": "node scripts/run-with-work-env.mjs node scripts/native-mongodb-correctness.mjs ping",
    "run:native:mongodb-ping": "node scripts/run-with-work-env.mjs node scripts/native-mongodb-correctness.mjs ping --run",
    "emit:native:mongodb-crud": "node scripts/run-with-work-env.mjs node scripts/native-mongodb-correctness.mjs crud --emit-only",
    "build:native:mongodb-crud": "node scripts/run-with-work-env.mjs node scripts/native-mongodb-correctness.mjs crud",
    "run:native:mongodb-crud": "node scripts/run-with-work-env.mjs node scripts/native-mongodb-correctness.mjs crud --run",
    "benchmark:drivers": "node scripts/run-with-work-env.mjs node benchmarks/run.mjs",
    "benchmark:stress": "node scripts/run-with-work-env.mjs node benchmarks/stress.mjs",
    "benchmark:http": "node scripts/run-with-work-env.mjs node benchmarks/http-stress.mjs",
    "benchmark:flex": "node scripts/run-with-work-env.mjs node benchmarks/flex.mjs",
    "native-Hono": "npm run native:hono",
    "native-Hono+Mongo": "npm run native:hono-mongodb"
  },
  "dependencies": {
    "@geajs/core": "1.4.0",
    "hono": "4.12.27",
    "mongodb": "7.1.1"
  },
  "devDependencies": {
    "@geajs/vite-plugin": "1.4.1",
    "@types/node": "22.15.3",
    "gcp-metadata": "7.0.1",
    "kerberos": "7.0.0",
    "mongodb-client-encryption": "7.0.0",
    "playwright-core": "1.61.1",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
